{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapSort",
  "version": "0.1.0",
  "identifier": "com.snapsort.desktop",

  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../frontend/dist"
  },

  "app": {
    "windows": [
      {
        "title": "SnapSort - AI Screenshot Organizer",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ]
  },

  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
